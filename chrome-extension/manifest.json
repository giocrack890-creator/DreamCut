{
  "manifest_version": 3,
  "name": "DreamCut — Descargador",
  "version": "1.0.0",
  "description": "Analiza y descarga videos de YouTube y TikTok (requiere el servidor local).",
  "permissions": ["downloads", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Descargar video"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
